{#
  dimred-coexpression page — UI

  tabPanel for "Gene coexpression". Layout:
    - top controls row: reduction selector, cell-subset toggle, graphics controls
    - left column: two feature selectors + assay, and the colour-scheme / cutoff /
      order plot controls
    - middle column: coexpression plot + download row
    - right column: 2D colour legend + download and the cell-number datatable
  Server counterpart: partials/server/dimred-coexpression.R.jinja.
#}
### dimred-coexpression page
tabPanel(
  HTML("Gene coexpression"),
  h4("Coexpression of two genes on reduced dimensions"),
  "In this tab, users can visualise the coexpression of two genes ",
  "on low-dimensional representions.",
  br(), br(),
  fluidRow(
    column(
      3, fluidRow(
        column(
          12, selectInput("<< d.prefix >>a3dr", "Reduction:", choices = << d.prefix >>def$dimrd,
                          selected = << d.prefix >>def$dimrd[1]))
      )
    ), # End of column (6 space)
    column(
      3, actionButton("<< d.prefix >>a3togL", "Toggle to subset cells"),
      conditionalPanel(
        condition = "input.<< d.prefix >>a3togL % 2 == 1",
        selectInput("<< d.prefix >>a3sub1", "Cell information to subset:",
                    choices = << d.prefix >>conf[grp == TRUE]$UI,
                    selected = << d.prefix >>def$grp1),
        uiOutput("<< d.prefix >>a3sub1.ui"),
        actionButton("<< d.prefix >>a3sub1all", "Select all groups", class = "btn btn-primary"),
        actionButton("<< d.prefix >>a3sub1non", "Deselect all groups", class = "btn btn-primary")
      )
    ), # End of column (6 space)
    column(
      6, actionButton("<< d.prefix >>a3tog0", "Toggle graphics controls"),
      conditionalPanel(
        condition = "input.<< d.prefix >>a3tog0 % 2 == 1",
        fluidRow(
          column(
            6, sliderInput("<< d.prefix >>a3siz", "Point size:",
                           min = 0, max = 4, value = << d.ptsiz >>, step = 0.25),
            radioButtons("<< d.prefix >>a3psz", "Plot size:",
                         choices = c("Small", "Medium", "Large"),
                         selected = "Medium", inline = TRUE),
            radioButtons("<< d.prefix >>a3fsz", "Font size:",
                         choices = c("Small", "Medium", "Large"),
                         selected = "Medium", inline = TRUE)
          ),
          column(
            6, radioButtons("<< d.prefix >>a3asp", "Aspect ratio:",
                            choices = c("Square", "Fixed", "Free"),
                            selected = "Square", inline = TRUE),
            checkboxInput("<< d.prefix >>a3txt", "Show axis text", value = FALSE)
          )
        )
      )
    ) # End of column (6 space)
  ), # End of fluidRow (4 space)
  fluidRow(
    column(
      3, style = "border-right: 2px solid black", h4("Assay Expression"),
      selectInput("<< d.prefix >>a3inp1", "Feature 1:", choices = NULL) %>%
        helper(type = "inline", size = "m", fade = TRUE,
              title = "Feature expression to colour cells by",
              content = c("Select gene to colour cells by gene expression",
                         paste0("- Feature expression are coloured in a ",
                                "White-Red colour scheme which can be ",
                                "changed in the plot controls"))),
      selectInput("<< d.prefix >>a3inp2", "Feature 2:", choices = NULL) %>%
        helper(type = "inline", size = "m", fade = TRUE,
               title = "Feature expression to colour cells by",
               content = c("Select gene to colour cells by gene expression",
                           paste0("- Feature expression are coloured in a ",
                                  "White-Blue colour scheme which can be ",
                                  "changed in the plot controls"))),
      selectInput("<< d.prefix >>a3ass1", "Assay:",
                  choices = << d.prefix >>def$assay,
                  selected = << d.prefix >>def$assay[1]),
      actionButton("<< d.prefix >>a3tog1", "Toggle plot controls"),
      conditionalPanel(
        condition = "input.<< d.prefix >>a3tog1 % 2 == 1",
        radioButtons("<< d.prefix >>a3col1", "Colour:",
                     choices = c("Red (Gene1); Blue (Gene2)",
                                 "Orange (Gene1); Blue (Gene2)",
                                 "Red (Gene1); Green (Gene2)",
                                 "Green (Gene1); Blue (Gene2)"),
                     selected = "Red (Gene1); Blue (Gene2)"),
        numericInput("<< d.prefix >>a3min1", "Min cutoff gene 1 (q##):",
                     min = 0, max = 50, value = 0, step = 1),
        numericInput("<< d.prefix >>a3max1", "Max cutoff gene 1 (q##):",
                     min = 50, max = 100, value = 100, step = 1),
        numericInput("<< d.prefix >>a3min2", "Min cutoff gene 2 (q##):",
                     min = 0, max = 50, value = 0, step = 1),
        numericInput("<< d.prefix >>a3max2", "Max cutoff gene 2 (q##):",
                     min = 50, max = 100, value = 100, step = 1),
        radioButtons("<< d.prefix >>a3ord1", "Plot order:",
                     choices = c("Max-1st", "Min-1st", "Original", "Random"),
                     selected = "Max-1st", inline = TRUE)
      )
    ), # End of column (6 space)
    column(
      6, style = "border-right: 2px solid black",
      uiOutput("<< d.prefix >>a3oup1.ui"),
      fluidRow(column(3, downloadButton("<< d.prefix >>a3oup1.dl", "Download Plot")),
               column(3, radioButtons("<< d.prefix >>a3oup1.f", "Plot format:",
                                      choices = c("png", "pdf"), selected = "png", inline = TRUE)),
               column(3, numericInput("<< d.prefix >>a3oup1.h", "Plot height:",
                                      min = 4, max = 20, value = 8, step = 0.5)),
               column(3, numericInput("<< d.prefix >>a3oup1.w", "Plot width:",
                                      min = 4, max = 20, value = 8, step = 0.5))),
      br()
    ), # End of column (6 space)
    column(
      3, uiOutput("<< d.prefix >>a3oup2.ui"),
      fluidRow(column(6, downloadButton("<< d.prefix >>a3oup2.dl", "Download Legend")),
               column(6, radioButtons("<< d.prefix >>a3oup2.f", "Legend format:",
                      choices = c("png", "pdf"), selected = "png", inline = TRUE))),
      br(), h4("Cell numbers"),
      dataTableOutput("<< d.prefix >>a3.dt")
    ) # End of column (6 space)
  ) # End of fluidRow (4 space)
) # End of tab (2 space)
,
