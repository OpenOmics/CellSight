{#
  trackplot page — UI (ATAC)

  tabPanel for "Track plot" (bigWig coverage tracks). Layout:
    - left column: input-method radio (Gene / Region) with the matching
      gene selector or chromosome + start/end inputs, group-by selector,
      bedfile selector, left/right extend inputs, colour toggle, track-subset
      toggle, Update-View button, and plot height/width inputs
    - right column: graphics controls (gene track / axis / transcript options,
      track heights, names position, font size) and the track plot output
  Only emitted for datasets with a <prefix>bw.rds. Server counterpart:
  partials/server/trackplot.R.jinja.
#}
### trackplot page
tabPanel(
  HTML("Track plot"),
  h4("Track plot"),
  "In this tab, users can visualise open chromatin regions.",
  br(), br(),
  fluidRow(
    column(
      3, style = "border-right: 2px solid black",
      radioButtons("<< d.prefix >>t1sel", "Input method:", choices = c("Gene", "Region"),
                   selected = "Region", inline = TRUE),
      conditionalPanel(
        condition = "input.<< d.prefix >>t1sel == 'Gene'",
        selectInput("<< d.prefix >>t1gene", "Gene:",
                    choices = NULL)),
      conditionalPanel(
        condition = "input.<< d.prefix >>t1sel == 'Region'",
        selectInput("<< d.prefix >>t1chr", "Chromosome:",
                    choices = << d.prefix >>bw$chrSize$chr,
                    selected = << d.prefix >>bw$chrGene[42]$chr),
        fluidRow(column(6, textInput("<< d.prefix >>t1srt", "Start", value = << d.prefix >>bw$chrGene[42]$srt)),
                 column(6, textInput("<< d.prefix >>t1end", "End", value = << d.prefix >>bw$chrGene[42]$end)))
      ),
      selectInput("<< d.prefix >>t1grp", "Group by:",
                  choices = << d.prefix >>bwGrp,
                  selected = << d.prefix >>bwGrp[1]),
      selectInput("<< d.prefix >>t1bed", "Track annotation bedfile:", choices = NULL),
      fluidRow(column(6, numericInput("<< d.prefix >>t1extL", "extend left by:",
                                      min = 0, max = 50000, value = 5000, step = 1000)),
               column(6, numericInput("<< d.prefix >>t1extR", "extend right by:",
                                      min = 0, max = 50000, value = 5000, step = 1000))),
      checkboxInput("<< d.prefix >>t1col",
                    label = "Check to color track plot:",
                    value = TRUE), # FALSE means "gray" is selected by default
      actionButton("<< d.prefix >>t1tog1", "Toggle to subset cells"),
      conditionalPanel(
        condition = "input.<< d.prefix >>t1tog1 % 2 == 1",
        uiOutput("<< d.prefix >>t1sub1.ui"),
        actionButton("<< d.prefix >>t1sub1all", "Select all groups", class = "btn btn-primary"),
        actionButton("<< d.prefix >>t1sub1non", "Deselect all groups", class = "btn btn-primary")
      ),
      div(style = "display:inline-block; float:right", actionButton("<< d.prefix >>t1update", "Update View")),
      br(), br(),
      fluidRow(column(6, numericInput("<< d.prefix >>t1track.h", "plot height (pixels):",
                                      min = 400, max = 2000, value = 600, step = 50)),
               column(6, numericInput("<< d.prefix >>t1track.w", "plot width (pixels):",
                                      min = 400, max = 2000, value = 1000, step = 50)))
    ),
    column(
      9, actionButton("<< d.prefix >>t1tog0", "Toggle graphics controls"),
      conditionalPanel(
        condition = "input.<< d.prefix >>t1tog0 % 2 == 1",
        fluidRow(
          column(4,
                 checkboxInput("<< d.prefix >>t1dgt", "Display gene track", value = TRUE),
                 checkboxInput("<< d.prefix >>t1asg", "Auto scale group", value = TRUE),
                 checkboxInput("<< d.prefix >>t1sha", "Show axis", value = TRUE),
                 checkboxInput("<< d.prefix >>t1ctx", "Collapse transcripts", value = TRUE)
          ),
          column(4,
                 sliderInput("<< d.prefix >>t1ath", "Annotation track height: ",
                             min = 1, max = 10, value = 2, step = 1),
                 sliderInput("<< d.prefix >>t1gth", "Gene track height: ",
                             min = 1, max = 10, value = 4, step = 1)
          ),
          column(4,
                 sliderInput("<< d.prefix >>t1tnp", "Track names position: ",
                             min = 0, max = 1, value = 0, step = 0.1),
                 sliderInput("<< d.prefix >>t1gsz", "Font size: ",
                             min = 0, max = 3, value = 2, step = 0.25)
          ))),
      uiOutput("<< d.prefix >>t1track.ui")
    ) # End of column (6 space)
  ) # End of fluidRow (4 space)
) # End of tab (2 space)
,
