{#
  spatial-zoom page — UI (single-slide variant)

  tabPanel for "Zoom-enable Spatial". Layout:
    - top controls row: dot-transparency slider, cell-subset toggle, graphics
      controls (point/plot/font size)
    - left column: metadata colour selector, the brushable preview plot (draw a
      box to zoom, double-click to reset), and colour / cutoff / label controls
    - middle column: main plot + legend outputs and download rows
    - right column: nBins input and the cell-number datatable
  One of the spatial-zoom variants selected by ui.R.jinja on d.multislide; the
  multi-slide variant adds a slide selector. Server: partials/server/spatial-zoom.R.jinja.
#}
### spatial-zoom page
tabPanel(
  HTML("Zoom-enable Spatial"),
  h4("Zoom-enable spatial plot overlaid with cell info or assay expression"),
  "In this tab, users can visualise either cell information and gene expression ",
  "in a zoom-enabled spatial plot.",
  br(), br(),
  fluidRow(
    column(
      3, fluidRow(
        column(
          12, sliderInput("<< d.prefix >>s1alp", "Dot transparency: ",
                          min = 0, max = 1, value = 1, step = 0.05))
      )
    ), # End of column (6 space)
    column(
      3, actionButton("<< d.prefix >>s1togL", "Toggle to subset cells"),
      conditionalPanel(
        condition = "input.<< d.prefix >>s1togL % 2 == 1",
        selectInput("<< d.prefix >>s1sub1", "Cell information to subset:",
                    choices = << d.prefix >>conf[grp == TRUE]$UI,
                    selected = << d.prefix >>def$grp1),
        uiOutput("<< d.prefix >>s1sub1.ui"),
        actionButton("<< d.prefix >>s1sub1all", "Select all groups", class = "btn btn-primary"),
        actionButton("<< d.prefix >>s1sub1non", "Deselect all groups", class = "btn btn-primary")
      )
    ), # End of column (6 space)
    column(
      6, actionButton("<< d.prefix >>s1tog0", "Toggle graphics controls"),
      conditionalPanel(
        condition = "input.<< d.prefix >>s1tog0 % 2 == 1",
        fluidRow(
          column(
            6, sliderInput("<< d.prefix >>s1siz", "Point size:",
                           min = << d.slider_min >>, max = << d.slider_max >>, value = << d.ptsiz_val >>, step = << d.slider_step >>),
            radioButtons("<< d.prefix >>s1psz", "Plot size:",
                         choices = c("Small", "Medium", "Large"),
                         selected = "Medium", inline = TRUE),
            radioButtons("<< d.prefix >>s1fsz", "Font size:",
                         choices = c("Small", "Medium", "Large"),
                         selected = "Medium", inline = TRUE)
          )
        )
      )
    ) # End of column (6 space)
  ), # End of fluidRow (4 space)
  fluidRow(
    column(
      3, style = "border-right: 2px solid black", h4("Information to plot"),
      selectInput("<< d.prefix >>s1inp1", "Cell metadata to colour plot:", choices = << d.prefix >>conf$UI, selected = << d.prefix >>def$meta1) %>%
        helper(type = "inline", size = "m", fade = TRUE,
               title = "Cell Info / Gene to colour cells by",
               content = c("Select cell info / feature to colour cells",
                           "- Categorical covariates have a fixed colour palette",
                           paste0("- Continuous covariates / gene expression are coloured ",
                                  "in a Blue-Yellow-Red colour scheme, which can be ",
                                  "changed in the plot controls"))),
      strong("Draw box on plot below to zoom (double-click to reset zoom): "),
      plotOutput("<< d.prefix >>s1oup1.br", height = "400px",
                 brush = brushOpts(id = "<< d.prefix >>s1inp1.br", resetOnNew = TRUE),
                 dblclick = "<< d.prefix >>s1inp1.br_dblclick"),
      actionButton("<< d.prefix >>s1tog1", "Toggle plot controls"),
      conditionalPanel(
        condition = "input.<< d.prefix >>s1tog1 % 2 == 1",
        radioButtons("<< d.prefix >>s1col1", "Colour (Continuous data):",
                     choices = c("White-Red", "Blue-Yellow-Red", "Yellow-Green-Purple"),
                     selected = "Blue-Yellow-Red"),
        numericInput("<< d.prefix >>s1min1", "Min cutoff (q##):",
                     min = 0, max = 50, value = 0, step = 1),
        numericInput("<< d.prefix >>s1max1", "Max cutoff (q##):",
                     min = 50, max = 100, value = 100, step = 1),
        checkboxInput("<< d.prefix >>s1lab1", "Show cell info labels", value = TRUE)
      )
    ), # End of column (6 space)
    column(
      6, style = "border-right: 2px solid black",
      fluidRow(column(12, uiOutput("<< d.prefix >>s1oup1.ui"))),
      fluidRow(column(12, uiOutput("<< d.prefix >>s1oup3.ui"))),
      fluidRow(column(3, downloadButton("<< d.prefix >>s1oup1.dl", "Download Plot")),
               column(3, radioButtons("<< d.prefix >>s1oup1.f", "Plot format:",
                                      choices = c("png", "pdf"), selected = "png", inline = TRUE)),
               column(3, numericInput("<< d.prefix >>s1oup1.h", "Plot height:",
                                      min = 4, max = 20, value = 8, step = 0.5)),
               column(3, numericInput("<< d.prefix >>s1oup1.w", "Plot width:",
                                      min = 4, max = 20, value = 8, step = 0.5))),
      fluidRow(column(3, downloadButton("<< d.prefix >>s1oup3.dl", "Download Legend")),
               column(3, radioButtons("<< d.prefix >>s1oup3.f", "Legend format:",
                                      choices = c("png", "pdf"), selected = "png", inline = TRUE)),
               column(3, numericInput("<< d.prefix >>s1oup3.h", "Legend height:",
                                      min = 0.2, max = 10, value = 2, step = 0.1)),
               column(3, numericInput("<< d.prefix >>s1oup3.w", "Legend width:",
                                      min = 4, max = 20, value = 8, step = 0.5))),
      br()
    ), # End of column (6 space)
    column(
      3, h4("Cell numbers"),
      numericInput("<< d.prefix >>s1splt", "Split continuous cell info into nBins:",
                   min = 2, max = 10, value = 4, step = 1),
      dataTableOutput("<< d.prefix >>s1.dt")
    ) # End of column (6 space)
  ) # End of fluidRow (4 space)
) # End of tab (2 space)
,
