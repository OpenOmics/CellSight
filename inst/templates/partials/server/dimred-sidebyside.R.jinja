output$<< d.prefix >>a2oup3.ui <- renderUI({plotOutput("<< d.prefix >>a2oup3", height = 72 * convertHeight(
  grobHeight(g_legend(<< d.prefix >>a2oup1())), unitTo = "in", valueOnly = TRUE) + 50)})
