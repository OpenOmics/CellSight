output$<< d.prefix >>a2sub1.ui <- renderUI({
  sub = strsplit(<< d.prefix >>conf[UI == input$<< d.prefix >>a2sub1]$fID, "\\|")[[1]]
  checkboxGroupInput("<< d.prefix >>a2sub2", "Select which cells to show", inline = TRUE,
                     choices = sub, selected = sub)
})
observeEvent(input$<< d.prefix >>a2sub1non, {
  sub = strsplit(<< d.prefix >>conf[UI == input$<< d.prefix >>a2sub1]$fID, "\\|")[[1]]
  updateCheckboxGroupInput(session, inputId = "<< d.prefix >>a2sub2", label = "Select which cells to show",
                           choices = sub, selected = NULL, inline = TRUE)
})
observeEvent(input$<< d.prefix >>a2sub1all, {
