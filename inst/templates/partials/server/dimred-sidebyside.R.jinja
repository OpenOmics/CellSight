{#
  dimred-sidebyside page — server

  Reactive logic for the "Side-by-side DimRed" page (two dimred scatters shown
  together plus a comparison panel). Wires up:
    - two colour-by feature selectors (left / right), each with server-side
      selectize choices coloured by data type (categorical / continuous /
      undetermined) via the shared optColor renderer
    - the cell-subset checkbox UI + select-all / deselect-all buttons
    - the two sc2Ddimr() plots, their legends, and download handlers
    - the sc2Dcomp() comparison plot and sc2Dcnum() statistics datatable
  Pairs with the UI in partials/ui/dimred-sidebyside.R.jinja.
#}
### dimred-sidebyside page
# Selectize render that colours each option by the data type used in the table
# calculations: categorical (green), continuous (blue), or undetermined (orange).
#  - Categorical = Cell Information with a defined factor colour list (fCL).
#  - Continuous  = Cell Information without an fCL whose values are numeric, plus
#                  all gene/feature expression (always numeric). These take the
#                  ggCont == TRUE path in sc2Dcnum / sc2Dcomp.
#  - Undetermined = anything that is neither - no fCL and not numeric (e.g.
#                  logical QC flags). Type cannot be exclusively determined.
# Genes are not listed in either set; they fall through to the continuous
# default below, which is correct.
optColCat = jsonlite::toJSON(<< d.prefix >>conf[!is.na(fCL)]$UI)
optColUnd = jsonlite::toJSON(<< d.prefix >>conf[is.na(fCL) &
                             !sapply(ID, function(i) i %in% colnames(<< d.prefix >>meta) &&
                                     is.numeric(<< d.prefix >>meta[[i]]))]$UI)
optColFn = paste0(
  "function(item, escape) {",
  "  var cat = ", optColCat, "; var und = ", optColUnd, ";",
  "  var c = cat.indexOf(item.value) > -1 ? '#1B7837' :",
  "          (und.indexOf(item.value) > -1 ? '#E66101' : '#2166AC');",
  "  return '<div style=\"color:' + c + ';font-weight:bold;text-align:center;\">' + escape(item.label) + '</div>';",
  "}")
optColor = paste0("{ option: ", optColFn, ", item: ", optColFn,
                  ", option_create: function(data,escape) {return('<div class=\"create\"><strong>' + '</strong></div>');} }")
getG<< d.prefix >>a2inp1 <- reactive({
  req(gsub("^Assay: ", "", input$<< d.prefix >>a2ass1))
  if (gsub("^Assay: ", "", input$<< d.prefix >>a2ass1) == "Cell Information") {
    res <- << d.prefix >>conf$UI
    resDef <- << d.prefix >>def$meta1
    resLen <- length(res)
  } else {
    res <- names(<< d.prefix >>gene[[gsub("^Assay: ", "", input$<< d.prefix >>a2ass1)]])
    resDef <- << d.prefix >>def$gene1[[gsub("^Assay: ", "", input$<< d.prefix >>a2ass1)]]
    resLen <- 7
  }
  return(list(res, resDef, resLen))
})
observeEvent(gsub("^Assay: ", "", input$<< d.prefix >>a2ass1), {
  updateSelectizeInput(session, "<< d.prefix >>a2inp1", choices = getG<< d.prefix >>a2inp1()[[1]],
                       server = TRUE, selected = getG<< d.prefix >>a2inp1()[[2]], options = list(
                         maxOptions = getG<< d.prefix >>a2inp1()[[3]], create = TRUE,
                         persist = TRUE, render = I(optColor)))
})
