  sc2Ddimr(<< d.prefix >>conf, << d.prefix >>meta, << d.prefix >>dimr, input$<< d.prefix >>a2dr, input$<< d.prefix >>a2inp1,
           "<< d.prefix >>assay_", << d.prefix >>gene, input$<< d.prefix >>a2ass1, input$<< d.prefix >>a2sub1, input$<< d.prefix >>a2sub2,
           input$<< d.prefix >>a2min1, input$<< d.prefix >>a2max1, input$<< d.prefix >>a2siz, input$<< d.prefix >>a2ord1,
           cList[[input$<< d.prefix >>a2col1]], sList[input$<< d.prefix >>a2fsz],
           input$<< d.prefix >>a2asp, input$<< d.prefix >>a2txt, input$<< d.prefix >>a2lab1)
})
output$<< d.prefix >>a2oup1 <- renderPlot({<< d.prefix >>a2oup1() + theme(legend.position = "none")})
output$<< d.prefix >>a2oup1.ui <- renderUI({plotOutput("<< d.prefix >>a2oup1", height = pList[input$<< d.prefix >>a2psz])})
output$<< d.prefix >>a2oup1.dl <- downloadHandler(
  filename = function() { paste0("<< d.prefix >>", input$<< d.prefix >>a2dr, "_", input$<< d.prefix >>a2inp1, ".", input$<< d.prefix >>a2oup1.f) },
  content = function(file) { ggsav(file, height = input$<< d.prefix >>a2oup1.h, width = input$<< d.prefix >>a2oup1.w,
                                   plot = << d.prefix >>a2oup1() + theme(legend.position = "none"))
})
