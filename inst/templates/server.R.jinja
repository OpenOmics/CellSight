{#
  server.R master template

  Assembles the generated server.R. makeShinyCodes() supplies `datasets` (one
  entry per dataset, with has_image / has_bw / has_deg flags) and renders this in
  three phases:
    1. library() calls (inlined below)
    2. {% for d in datasets %} data-load block: reads <prefix>{conf,meta,gene,dimr,def};
       plus data-load-spatial (if has_image) and data-load-track (if has_bw)
    3. preamble: palettes, panel/font size lists, and shinyServer(function(){ ... open
    4. {% for d in datasets %} one server partial per page, gated by data type:
         spatial-zoom, spatial-sidebyside      (if has_image)
         trackplot                             (if has_bw)
         dimred-zoom, dimred-split, dimred-sidebyside
         deg-dimred                            (if has_deg)
         dimred-coexpression, violin-box, proportion, bubble-heatmap, module-score
    5. closing: }) to close shinyServer
  Keep the {% ... %} tags packed on one line — see README ("Whitespace in the
  masters"). Per-page reactive logic lives in partials/server/<page>.R.jinja.
#}
library(shiny)
library(shinyhelper)
library(data.table)
library(Matrix)
library(DT)
library(magrittr)
library(ggplot2)
library(ggrepel)
library(hdf5r)
library(ggdendro)
library(grid)
library(gridExtra)
{% for d in datasets %}<< d.prefix >>conf = readRDS("./<< d.prefix >>conf.rds")
<< d.prefix >>meta = readRDS("./<< d.prefix >>meta.rds")
<< d.prefix >>gene = readRDS("./<< d.prefix >>gene.rds")
<< d.prefix >>dimr = readRDS("./<< d.prefix >>dimr.rds")
<< d.prefix >>def  = readRDS("./<< d.prefix >>def.rds")
{% if d.has_image %}<< d.prefix >>image = readRDS("./<< d.prefix >>image.rds")
if(is.null(<< d.prefix >>image$slide_display_names)) << d.prefix >>image$slide_display_names <- << d.prefix >>image$slide_names
{% endif %}{% if d.has_bw %}<< d.prefix >>bw   = readRDS("./<< d.prefix >>bw.rds")
{% endif %}{% endfor %}source("./shinyFunc.R")
pdf(file = NULL)



